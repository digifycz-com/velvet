# Zkopíruj do functions/.env a doplň reálné hodnoty.
# Tajné hodnoty (…_CLIENT_SECRET) NEDÁVEJ sem – nastav je přes:
#   firebase functions:secrets:set FOODORA_CLIENT_SECRET
#   firebase functions:secrets:set WOLT_CLIENT_SECRET

# --- Foodora / Delivery Hero (Catalog API) ---
FOODORA_CLIENT_ID=
FOODORA_CHAIN_ID=
FOODORA_VENDOR_ID=

# --- Wolt (Menu API) ---
WOLT_CLIENT_ID=
WOLT_VENUE_ID=
