rules_version = '2';

// ============================================================================
// PASÁŽ VELVET – Firestore pravidla
//
// Denní menu (dailyMenus) čte veřejná landing page → čtení musí být veřejné.
// Zápis by měl být jen pro přihlášeného admina.
//
// POZOR: administrace má teď vypnuté přihlášení (AUTH_ENABLED=false v admin.js).
// Než nasadíš tato pravidla, ZAPNI přihlášení, jinak nepůjde z adminu ukládat.
// Pro dočasný vývoj lze použít otevřenou variantu (viz komentář dole).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /dailyMenus/{date} {
      allow read: if true;                       // veřejné čtení (landing page)
      allow write: if request.auth != null;      // zápis jen přihlášený admin
    }

    // Vše ostatní zakázáno.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ----------------------------------------------------------------------------
// DOČASNÁ VÝVOJOVÁ VARIANTA (než zapneš přihlášení) – NENECHÁVAT v produkci:
//
//   match /dailyMenus/{date} {
//     allow read, write: if true;
//   }
// ----------------------------------------------------------------------------
