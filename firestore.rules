rules_version = '2';

// ============================================================================
// PASÁŽ VELVET – Firestore pravidla
//
// Denní menu (dailyMenus) čte veřejná landing page → čtení musí být veřejné.
// Zápis je povolený pouze účtu s admin claimem, který vydává serverová
// funkce po ověření společného hesla.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /dailyMenus/{date} {
      allow read: if true;                       // veřejné čtení (landing page)
      allow write: if request.auth != null
                   && request.auth.token.admin == true;
    }

    match /siteContent/{document} {
      allow read: if true;                       // aktuality a veřejné jídelní lístky
      allow write: if request.auth != null       // editace pouze ověřeným adminem
                   && request.auth.token.admin == true;
    }

    // Vše ostatní zakázáno.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
